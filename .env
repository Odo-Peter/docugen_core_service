# --- Host port overrides ---
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+psycopg://docgen:docgen@localhost:5432/docgen

# --- App ---
APP_ENV=development           # development | production
LOG_LEVEL=info

# --- Limits (see ADR 0001 / API contract) ---
MAX_REQUEST_BODY_BYTES=5242880       # 5 MB
MAX_TEMPLATE_BYTES=1048576           # 1 MB (html + css combined)
RENDER_TIMEOUT_SECONDS=30
PAGE_LIMIT=0                          # TODO: set from the benchmark (step 4); 0 = unset/blocks startup in prod

# --- Rate limiting (M2, simple per-key limiter) ---
RATE_LIMIT_PER_MINUTE=60

# --- Deferred: milestone 4, async jobs & batching ---
# Not read by the app yet — uncommented and wired up when M4 starts.
# See ADR 0001, "Decided, deferred", for the Celery/Redis/MinIO reasoning.
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=docgen-outputs
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- Deferred: milestone 5, webhooks ---
# WEBHOOK_SIGNING_SECRET=CHANGE_ME