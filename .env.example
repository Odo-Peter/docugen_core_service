# Copy to .env and adjust. Never commit the real .env.

# --- Host port overrides ---
# Only change these if the default port is already taken on your machine
# (e.g. a local Postgres install, or another project's container).
# These affect HOST-side access only — containers still talk to each other
# over the internal Compose network on the default ports (db:5432, api:8000),
# so nothing else needs to change when you remap these.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# --- Database ---
# Used by the api container when running standalone (outside `make up`) or
# by local tools (psql, a DB GUI, running alembic on the host). If you
# changed POSTGRES_HOST_PORT above, update the port here too — this is the
# one place it doesn't update itself, since it's a full connection string,
# not a bare port mapping.
DATABASE_URL=postgresql+psycopg://docgen:docgen@localhost:5432/docgen

# --- App ---
APP_ENV=development           # development | production
LOG_LEVEL=info

# --- Limits (see ADR 0001 / API contract) ---
MAX_REQUEST_BODY_BYTES=5242880       # 5 MB
MAX_TEMPLATE_BYTES=1048576           # 1 MB (html + css combined)
RENDER_TIMEOUT_SECONDS=30
PAGE_LIMIT=0                          # TODO: set from the benchmark (step 4); 0 = unset/blocks startup in prod

# --- Rate limiting (M2, simple per-key limiter) ---
RATE_LIMIT_PER_MINUTE=60

# --- Deferred: milestone 4, async jobs & batching ---
# Not read by the app yet — uncommented and wired up when M4 starts.
# See ADR 0001, "Decided, deferred", for the Celery/Redis/MinIO reasoning.
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=docgen-outputs
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- Deferred: milestone 5, webhooks ---
# WEBHOOK_SIGNING_SECRET=CHANGE_ME